{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-lackey",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-13",
  // Fixture feeds import as text. Only integration tests import them; the Worker reads live feeds.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/fixtures/feeds/*.xml", "**/fixtures/feeds/*.json"],
      "fallthrough": true
    },
    // Prompt files (JSU-29). Each Run stores a hash of each prompt's text.
    { "type": "Text", "globs": ["**/prompts/*.md"], "fallthrough": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "research-lackey",
      "database_id": "abea58fc-0ac6-46e1-9876-76c5141356f8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "workflows": [{ "name": "research-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "research-lackey" }],
  // Secrets, never committed: CF_AIG_TOKEN, CF_ACCOUNT_ID, AI_GATEWAY_ID, and optionally
  // AI_GATEWAY_BYOK_ALIAS (.dev.vars locally).
  "vars": {
    "LOG_LEVEL": "info",
    // Sent as `env` in AI Gateway metadata. `.dev.vars` sets "dev" locally.
    "APP_ENV": "prod"
  },
  "routes": [{ "pattern": "lackey.jsulz.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
